local dir=$(fd --type d --hidden --exclude .git --exclude node_modules 2>/dev/null |
  _fzf_tmux_popup --pipe --select-1 --exit-0 \
    --preview 'ls -lah {}' \
    --preview-window 'right:60%:wrap')
local ret=$?

if [ $ret -eq 0 ] && [ -n "$dir" ]; then
  cd "$dir"
  zle reset-prompt
fi

return $ret

# vim: ft=zsh
