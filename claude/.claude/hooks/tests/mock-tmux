#!/usr/bin/env bash
# Test stub for tmux. Answers `display-message -p ... -F <fmt>` with the
# canned "<pane_active> <window_active> <session_attached>" triple in
# $MOCK_TMUX_STATE (default "0 0 0" — pane not being viewed).
# Used by run-tests.sh to exercise the ntfy-notify tmux-focus guard.
set -u
if [[ "${1:-}" == "display-message" ]]; then
  printf '%s\n' "${MOCK_TMUX_STATE:-0 0 0}"
  exit 0
fi
exit 0
