# Create a new directory and enter it
function md() {
  mkdir -p "$@" && cd "$1"
}

# find shorthand
function f() {
  find . -name "$1" 2>&1 | grep -v 'Permission denied'
}

# List all files, long format, colorized, permissions in octal
function la() {
   ls -l  "$@" | awk '
    {
      k=0;
      for (i=0;i<=8;i++)
        k+=((substr($1,i+2,1)~/[rwx]/) *2^(8-i));
      if (k)
        printf("%0o ",k);
      printf(" %9s  %3s %2s %5s  %6s  %s %s %s\n", $3, $6, $7, $8, $5, $9,$10, $11);
    }'
}

# git commit browser. needs fzf
function log() {
  git log --graph --color=always \
    --format="%C(auto)%h%d %s %C(black)%C(bold)%C(white)%cr %Creset(%C(green)%cn <%ce>)" "$@" |
  fzf --tmux center,80%,60% --no-sort --tiebreak=index --toggle-sort=\` \
      --preview "echo {} | grep -o '[a-f0-9]\{7\}' | head -1 | xargs git show --color=always" \
      --preview-window down,70%,wrap
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
  local port="${1:-9000}"
  # statik is good because it won't expose hidden folders/files by default.
  # npm install -g browser-sync
  browser-sync start -s -f . --no-notify --port "$port"
}

# Copy w/ progress
function cp_p () {
  rsync -WavP --human-readable --progress $1 $2
}

# get gzipped size
function gz() {
  echo "orig size    (bytes): "
  cat "$1" | wc -c
  echo "gzipped size (bytes): "
  gzip -c "$1" | wc -c
}

# whois a domain or a URL
function whois() {
  local domain=$(echo "$1" | awk -F/ '{print $3}') # get domain from URL
  if [ -z "$domain" ] ; then
    domain=$1
  fi
  echo "Getting whois record for: $domain …"

  # avoid recursion
  # this is the best whois server
  # strip extra fluff
  /usr/bin/whois -h whois.internic.net "$domain" | sed '/NOTICE:/q'
}

# turn that video into webm.
# brew reinstall ffmpeg --with-libvpx
function webmify() {
  ffmpeg -i $1 -vcodec libvpx -acodec libvorbis -isync -copyts -aq 80 -threads 3 -qmax 30 -y $2 $1.webm
}

# direct it all to /dev/null
function nullify() {
  "$@" >/dev/null 2>&1
}

# wttr.in
function wttr() {
  curl -H "Accept-Language: ${LANG%_*}" wttr.in/"${1:-Madrid}"
}

# Git short stat.
function shortstat() {
  git log --shortstat $1 | \
  awk '/^ [0-9]/ { f += $1; i += $4; d += $6 } \
  END { printf("%d files changed, %d insertions(+), %d deletions(-)", f, i, d) }'
  echo ''
}

# Git checkout fuzzy with fzf.
function select_branch() {
  local branches=$(git branch --all --sort=-committerdate 2>/dev/null)

  if [ -z "$branches" ]; then
    return 1
  fi

  local branch=$(echo "$branches" | awk '{ if ($1 != "*") { print $1 } }' |
    sed -e 's/remotes\///' -e 's/origin\///' | awk '!x[$0]++' |
    fzf --tmux center,80%,60% --no-sort --tiebreak=index --toggle-sort=\` --select-1 --exit-0 --query="$@")

  if [ -z "$branch" ]; then
    return 1
  fi

  echo -n "$branch"

  return 0
}

# Git tag fuzzy with fzf.
function select_tag() {
  local tags=$(git tag --sort=-committerdate 2>/dev/null)

  if [ -z "$tags" ]; then
    return 1
  fi

  local tag=$(echo "$tags" | awk '!x[$0]++' |
    fzf --tmux center,80%,60% --no-sort --tiebreak=index --toggle-sort=\` --select-1 --exit-0 --query="$@")

  if [ -z "$tag" ]; then
    return 1
  fi

  echo -n "$tag"

  return 0
}

# Fuzzy vim
function fvim() {
  local files=$(fzf --tmux center,80%,60% --multi --select-1 --exit-0 --query="$@" \
    --preview 'bat --color=always --style=numbers --line-range :500 --theme=TwoDark {}' \
    --preview-window 'right:60%:wrap')

  if [ -z "$files" ]; then
    return 1
  fi

  ${EDITOR:-vim} "${files[@]}"
}

# Quick transfers.
function transfer() {
  if [ $# -eq 0 ]; then
    echo -e "No arguments specified. Usage:\necho transfer /tmp/test.md\ncat /tmp/test.md | transfer test.md"
    return 1
  fi

  tmpfile=$( mktemp -t transferXXX )

  if tty -s; then
    basefile=$(basename "$1" | sed -e 's/[^a-zA-Z0-9._-]/-/g')
    curl --progress-bar --upload-file "$1" "https://transfer.sh/$basefile" >> $tmpfile
  else
    curl --progress-bar --upload-file "-" "https://transfer.sh/$1" >> $tmpfile
  fi

  cat $tmpfile
  rm -f $tmpfile >/dev/null
}

# Find branch for a given commit.
function git-plumb() {
  commit=$(git rev-parse $1) # expands hash if needed
  for branch in $(git for-each-ref --format "%(refname)" refs/heads); do
    if git rev-list "$branch" | grep -Fq "$commit"; then
      echo -n "$branch"
    fi
  done
}

# Cheatsheet search.
function cheat() {
  curl "cheat.sh/$*"
}

# Note taking.
function n() {
  : "${NOTE_DIR:?'NOTE_DIR ENV Var not set'}"
  if [ $# -eq 0 ]; then
    local file
    file=$(find "${NOTE_DIR}" -name "*.md" | \
      sed -e "s|${NOTE_DIR}/||" | \
      sed -e 's/\.md$//' | \
      fzf --tmux center,80%,60% --multi --select-1 --exit-0 \
        --preview="bat --color=always --style=numbers --theme=TwoDark ${NOTE_DIR}/{}.md" \
        --preview-window=right:60%:wrap)
    [[ -n $file ]] && \
      ${EDITOR:-vim} "${NOTE_DIR}/${file}.md"
  else
    case "$1" in
      "-d")
        rm "${NOTE_DIR}"/"$2".md
        ;;
      *)
        ${EDITOR:-vim} "${NOTE_DIR}"/"$*".md
        ;;
    esac
  fi
}

# Setup semantic-release env.
function semantic_env() {
  name=$(git config user.name)
  email=$(git config user.email)

  export GIT_AUTHOR_NAME=${name}
  export GIT_AUTHOR_EMAIL=${email}
  export GIT_COMMITTER_NAME=${name}
  export GIT_COMMITTER_EMAIL=${email}
}

# Show a notify message.
function notify() {
  local text="${1}"
  local title="${2}"
  local subtitle="${3}"
  # List of sounds: /System/Library/Sounds
  local sound="${4:-Glass}"
  local str="display notification \"${text}\" "

  if [ -n "${title}" ]; then
    str+="with title \"${title}\" "
  fi

  if [ -n "${subtitle}" ]; then
    str+="subtitle \"${subtitle}\" "
  fi

  str+="sound name \"${sound}\" "

  osascript -e "${str}"
}

function killport() {
  local port="${1}"

  kill $(lsof -t -i:$port)
}

# Helper for running fzf in tmux popup from ZLE widgets.
# Handles piped input and argument quoting across the tmux popup boundary.
# Pass --pipe as the FIRST argument when piping data into fzf.
# Usage: echo "items" | _fzf_tmux_popup --pipe [fzf-args...]
#   or:  _fzf_tmux_popup [fzf-args...]  (uses FZF_DEFAULT_COMMAND)
function _fzf_tmux_popup() {
  setopt localoptions clobber

  local tmpdir="${TMPDIR:-/tmp}/fzf-popup-$$"
  mkdir -p "$tmpdir"

  local has_input=0
  if [ "$1" = "--pipe" ]; then
    shift
    cat > "$tmpdir/input"
    has_input=1
  fi

  if [ -n "$TMUX" ]; then
    # Dump env vars for the popup's bash subprocess.
    export -p | grep -E '^export (FZF_DEFAULT_COMMAND|FZF_DEFAULT_OPTS|PATH)=' > "$tmpdir/env"

    # Build a self-contained bash script to avoid quoting issues.
    {
      echo '#!/usr/bin/env bash'
      echo "source '$tmpdir/env'"
      if [ "$has_input" -eq 1 ]; then
        echo "cat '$tmpdir/input' | fzf ${(j: :)${(qq)@}} > '$tmpdir/output'"
      else
        echo "fzf ${(j: :)${(qq)@}} > '$tmpdir/output'"
      fi
    } > "$tmpdir/run.sh"
    chmod +x "$tmpdir/run.sh"

    tmux popup -d "$PWD" -w 80% -h 60% -E "$tmpdir/run.sh"
  else
    if [ "$has_input" -eq 1 ]; then
      fzf "$@" < "$tmpdir/input" > "$tmpdir/output"
    else
      fzf "$@" > "$tmpdir/output"
    fi
  fi

  local ret=1
  if [ -s "$tmpdir/output" ]; then
    cat "$tmpdir/output"
    ret=0
  fi

  command rm -rf "$tmpdir"
  return $ret
}

# Directory jump with fzf.
function select_directory() {
  local dir=$(fd --type d --hidden --exclude .git --exclude node_modules 2>/dev/null |
    fzf --tmux center,80%,60% --select-1 --exit-0 --query="$@" \
      --preview 'ls -lah {}' \
      --preview-window 'right:60%:wrap')

  if [ -z "$dir" ]; then
    return 1
  fi

  echo -n "$dir"

  return 0
}

# vim: ft=zsh
