# vim as default
export EDITOR="nvim"
export VISUAL="nvim"

# Homebrew for M1
if [ -d "/opt/homebrew" ]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
  export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi

# Skip puppeteer on M1
if command -v chromium >/dev/null 2>&1; then
  export PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
  export PUPPETEER_EXECUTABLE_PATH=$(command -v chromium)
fi

# Don't clear the screen after quitting a manual page
export MANPAGER="less -X"
export PAGER="less"

# Lang
export LANG="en_US.UTF-8"
export LC_ALL=${LANG}

# MacOS
export PATH="/usr/local/bin:${PATH}"
export PATH="/usr/local/sbin:${PATH}"

# Texlive
[ -d "/Library/TeX/texbin" ] && export PATH="${PATH}:/Library/TeX/texbin"

# Home bin
export PATH="${PATH}:$HOME/bin"

# Local bin
export PATH="${PATH}:$HOME/.local/bin"

# XDG config home.
export XDG_CONFIG_HOME="$HOME/.config"

# NPM
export npm_config_progress=false
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

# Node
export NODE_OPTIONS="--max-old-space-size=4096 --max-http-header-size=49152"

# Notes
export NOTE_DIR="$HOME/Dropbox/Texts"

# Fzf
export FZF_DEFAULT_COMMAND="rg --files --hidden --glob \!.git --follow 2> /dev/null"
export FZF_DEFAULT_OPTS="--reverse --ansi "

# Ruby (cached gem path to avoid slow subprocess on every shell start).
if command -v ruby >/dev/null 2>&1 && command -v gem >/dev/null 2>&1; then
  _ruby_version="$(ruby -e 'print RUBY_VERSION')"
  _gem_cache="${XDG_CONFIG_HOME:-$HOME/.config}/gem_path_cache"
  if [ -f "$_gem_cache" ] && [ "$(head -1 "$_gem_cache")" = "$_ruby_version" ]; then
    PATH="$(tail -1 "$_gem_cache")/bin:$PATH"
  else
    _gem_dir="$(ruby -r rubygems -e 'puts Gem.user_dir')"
    mkdir -p "$(dirname "$_gem_cache")"
    printf '%s\n%s\n' "$_ruby_version" "$_gem_dir" > "$_gem_cache"
    PATH="$_gem_dir/bin:$PATH"
    unset _gem_dir
  fi
  unset _ruby_version _gem_cache
fi

# Fix GPG
export GPG_TTY=$(tty)

# highlighting inside manpages and elsewhere
export LESS_TERMCAP_mb=$'\E[01;31m'       # begin blinking
export LESS_TERMCAP_md=$'\E[01;38;5;74m'  # begin bold
export LESS_TERMCAP_me=$'\E[0m'           # end mode
export LESS_TERMCAP_se=$'\E[0m'           # end standout-mode
export LESS_TERMCAP_so=$'\E[38;5;246m'    # begin standout-mode - info box
export LESS_TERMCAP_ue=$'\E[0m'           # end underline
export LESS_TERMCAP_us=$'\E[04;38;5;146m' # begin underline

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# vim: ft=sh
